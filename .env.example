# Copy to .env.local for local development.
# Also set these in Cloudflare Workers → Settings → Variables before deploy.

NEXT_PUBLIC_SANITY_PROJECT_ID=7369p9av
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_STUDIO_URL=https://celeste-environmental.sanity.studio

# Optional: only needed for draft/preview content
# SANITY_API_READ_TOKEN=

# Canonical public URL used for canonical tags, sitemap, Open Graph, and JSON-LD.
# Set this to the custom domain once one is connected (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://celestehedequistenv.com

# Search console ownership verification (meta tag values only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
